  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &726936755
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 726936754}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abb02003c17124a42a6ce09101cd4c61, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  narrationBox: {fileID: 791443861}
  startLines:
  - Welcome to the gravity science minigame! In this, we will teach what makes up
    the force of gravity and why this is so important to the Psyche mission. There
    are two main reasons this is so important.
  - First off, if we know the force of gravity, it will be much easier to maneuver
    the satellite and complete the other investigations of Psyche.
  - But beyond that, we will also be able to determine if the inside of Psyche is
    hollow or not, which will determine if this could have potentially been a core
    of a planet at one point!
  - For now, try pressing the button on the console before you and see what happens.
  buttonPressLines:
  - What you just saw was the satellite flying by the asteroid. You may have also
    noticed the force of gravity equation showing the actual values and the force
    of gravity.
  - In this situation, the force of gravity is the product of the gravitational constant,
    the mass of our satellite, and the mass of Psyche divided by the distance between
    the satellite and Psyche squared.
  - What this essentially means is that the larger the mass of either object is,
    the larger the force of gravity will also be, and the closer these two objects
    are will also increase the force of gravity.
  - 'Now, try moving the slider to either side to change the mass of Psyche and see
    how that affects the gravity! '
  gravityIncreaseLines:
  - Looks like you made the mass higher! That of course means that the force of gravity
    has also increased, as you can see by comparing your trails.
  - ' If the gravity on Psyche is strong like this, that means that the mass of the
    asteroid is high and the asteroid is likely not hollow, which means this could
    have been the core of a planetesimal at one point!'
  - 'This means it was going to become the core of a planet, before the process of
    creation was interrupted. '
  gravityDecreaseLines:
  - Looks like you chose to make the mass lower! Which means the force of gravity
    has decreased as well, which you can see by comparing your trails.
  - 'If the gravity on Psyche is weaker like this, that means that the asteroid has
    a low mass and is likely hollow, which means this is simply a metal asteroid
    and not a planetesimal core. '
  endLines:
  - 'Congratulations! You now know how gravity will be used to aid the Psyche investigations. '
  - "That\u2019s all for the gravity science minigame, thanks for playing!"
  startAudioLines:
  - {fileID: 8300000, guid: dcb1da9c81eb5704f988605e4f68ba79, type: 3}
  - {fileID: 8300000, guid: 56ed459f7a47908429b397992d6bea9d, type: 3}
  - {fileID: 8300000, guid: 8d5192a13c4b57f4ebb68daa79a4aec9, type: 3}
  - {fileID: 8300000, guid: 229c58dfb9778594385e4ac3e8bba80c, type: 3}
  buttonPressAudioLines:
  - {fileID: 8300000, guid: ac45b43a826e23248b7a15d142cd46a5, type: 3}
  - {fileID: 8300000, guid: bb570e82132b2b3458a8969ccd0cbac8, type: 3}
  - {fileID: 8300000, guid: d8afe60a5dd58f4478cdf20d7d5bf48a, type: 3}
  - {fileID: 8300000, guid: fc5600c9b933bad4b9d92ea4466b9470, type: 3}
  gravityIncreaseAudioLines:
  - {fileID: 8300000, guid: 4ceff60358d3e9f46a43921ae407d3f2, type: 3}
  - {fileID: 8300000, guid: af6a91496312f2448a47eba2f3a52a00, type: 3}
  - {fileID: 8300000, guid: 8e496804f36809d40bb4179124468160, type: 3}
  gravityDecreaseAudioLines:
  - {fileID: 8300000, guid: 4a15758e3b23fdf4db888f4472dcdd24, type: 3}
  - {fileID: 8300000, guid: 890a29114ee452d45ad3a0b804b33803, type: 3}
  endAudioLines:
  - {fileID: 8300000, guid: 801010b261b40604ca002cfd8e3e986e, type: 3}
  - {fileID: 8300000, guid: 24d0af1f62e30e5408b16e9f9858aa93, type: 3}
  console: {fileID: 6008871353299168166}
